{
	admin off
	persist_config off
}

:8080 {
	handle /club {
		header Content-Type "text/plain; charset=utf-8"
		header X-Content-Type-Options "nosniff"
		root * /srv
		file_server
	}

	handle /artifacts/community-club-02e82f85ebcd9d0e7cb757f0906aea434a1b84b3.tar {
		header Content-Type "application/x-tar"
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		root * /srv
		file_server
	}

	handle /health {
		header Content-Type "application/json; charset=utf-8"
		respond "{\"service\":\"community-club-installer\",\"commit\":\"02e82f85ebcd9d0e7cb757f0906aea434a1b84b3\"}" 200
	}

	handle {
		respond 404
	}
}
