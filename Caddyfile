{
	admin off
	persist_config off
}

:8080 {
	handle /club {
		header Content-Type "text/plain; charset=utf-8"
		header X-Content-Type-Options "nosniff"
		root * /srv
		file_server
	}

	handle /artifacts/community-club-ca80b6c49965c2c1204ad37a825ba6ffe198e0b8.tar {
		header Content-Type "application/x-tar"
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		root * /srv
		file_server
	}

	handle /health {
		header Content-Type "application/json; charset=utf-8"
		respond "{\"service\":\"community-club-installer\",\"commit\":\"ca80b6c49965c2c1204ad37a825ba6ffe198e0b8\"}" 200
	}

	handle {
		respond 404
	}
}
