	admin off
	persist_config off
}

:8080 {
	handle /club {
		header Content-Type "text/plain; charset=utf-8"
		header X-Content-Type-Options "nosniff"
		root * /srv
		file_server
	}

	handle /artifacts/community-club-eba5585bf7651447ebd6f93ce0ddfb259ad49983.tar {
		header Content-Type "application/x-tar"
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		root * /srv
		file_server
	}

	handle /health {
		header Content-Type "application/json; charset=utf-8"
		respond "{\"service\":\"community-club-installer\",\"commit\":\"eba5585bf7651447ebd6f93ce0ddfb259ad49983\"}" 200
	}

	handle {
		respond 404
	}
}
